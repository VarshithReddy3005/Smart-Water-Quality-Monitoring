# ========================================================
# AquaGuard: Smart Water Quality Monitoring Configuration
# ========================================================

# Project Identity
PROJECT_NAME="AquaGuard - Smart Water Quality Monitoring System"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="aquaguard-super-secure-production-secret-key-change-in-prod-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# If left commented or set to sqlite, automatically uses local SQLite zero-config database
DATABASE_URL="sqlite:///./aquaguard.db"
# Production PostgreSQL URL:
# DATABASE_URL="postgresql://aquaguard:aquaguard_secure_password@localhost:5432/aquaguard_db"

# MQTT Broker (Physical IoT Telemetry)
MQTT_ENABLED=false
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX="aquaguard"

# Synthetic Telemetry Simulation Engine
SIMULATION_ENABLED_DEFAULT=true
SIMULATION_INTERVAL_SECONDS=3

# Alert Dispatch & Notifications (Optional SMTP)
SMTP_SERVER=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="alerts@aquaguard.io"
